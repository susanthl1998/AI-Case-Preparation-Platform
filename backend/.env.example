# Copy to .env and fill in real values for your environment.
# Never commit the real .env file — it is in .gitignore.

ENVIRONMENT=development
DEBUG=true

# =============================================================================
# PostgreSQL — relational source of truth
# accounts, profiles, sessions, case metadata (see ADR-01 / ADR-02)
# =============================================================================
# Example for the docker-compose Postgres service:
#   DATABASE_URL=postgresql+psycopg2://casearena:casearena@localhost:5432/casearena
# Managed Postgres (Neon, Cloud SQL, ...) — note the +psycopg2 driver suffix,
# which most providers' copy-paste connection strings omit:
#   DATABASE_URL=postgresql+psycopg2://user:pass@host/db?sslmode=require
# SQLite is acceptable only for a zero-dependency local smoke test:
DATABASE_URL=sqlite:///./dev.db

# =============================================================================
# MongoDB — document store for Module 1 (AI Trainer)
# chat transcripts, AI evaluation results, RAG artifacts
# =============================================================================
# Optional: leave blank and the service still starts and serves Module 2
# (accounts, profiles, case repository), which never touches Mongo.
#   MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_URI=
MONGODB_DATABASE=casearena

# =============================================================================
# Auth
# =============================================================================
# Generate a real secret for anything beyond local dev:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# =============================================================================
# Case PDF uploads (FR-09: PDF up to 10 MB)
# =============================================================================
MAX_UPLOAD_SIZE_BYTES=10485760
UPLOAD_STORAGE_DIR=./storage/uploads

# Where uploaded PDFs live: "local" | "database" | "s3".
#
# Do NOT use "local" in any hosted deployment — almost every PaaS wipes
# local disk on redeploy or restart, silently destroying every uploaded
# PDF. Use "database" (bytes in Postgres; no extra account or credentials)
# or "s3" (AWS S3, or S3-compatible like Cloudflare R2 via S3_ENDPOINT_URL;
# the right choice past demo volumes). See ADR-07.
STORAGE_BACKEND=local

# Only read when STORAGE_BACKEND=s3. Leave S3_ENDPOINT_URL blank for real
# AWS S3; set it to the provider's endpoint for R2/MinIO/etc.
S3_BUCKET_NAME=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=

# =============================================================================
# API / CORS
# =============================================================================
# Where the versioned API is mounted. Changing this changes every endpoint
# URL — coordinate across teams before touching it.
API_V1_PREFIX=/api/v1

# The frontend origin(s) allowed to call this API. pydantic-settings needs a
# JSON array string here, not a comma-separated list.
CORS_ALLOW_ORIGINS=["http://localhost:5173"]
