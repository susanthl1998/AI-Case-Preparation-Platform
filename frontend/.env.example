# Copy to .env.local and adjust for your environment.
#
# Host only, no path — the /api/v1 prefix is appended in src/api/client.js.
# In a cloud dev environment (Codespaces/Gitpod) set this to the forwarded
# backend URL: a browser running outside the container cannot reach
# localhost:8000.
VITE_API_BASE_URL=http://localhost:8000

# Only needed if the API is mounted somewhere other than /api/v1.
# VITE_API_PREFIX=/api/v1
